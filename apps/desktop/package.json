    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
