{
  "name": "open-powerz-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop tauri dev",
    "build:web": "bun run --cwd apps/desktop build",
    "check": "bun run --cwd apps/desktop check",
    "lint": "bun run --cwd apps/desktop lint",
    "format": "bun run --cwd apps/desktop format",
    "test": "bun run --cwd apps/desktop test",
    "e2e:ui": "bun run --cwd apps/desktop e2e:ui",
    "e2e:app": "bun run --cwd apps/desktop e2e:app"
  }
}
